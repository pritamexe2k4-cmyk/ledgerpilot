# Copy to .env (never commit the real file). All values below are placeholders.
APP_ENV=dev

# Supabase (Day 2): project URL and a service-role key kept server-side only
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# LLM provider (Day 2/3): use whichever free/cheap tier you pick
LLM_PROVIDER=groq            # groq | gemini | azure_openai
GROQ_API_KEY=replace-me
GEMINI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=replace-me

# Frontend (Day 5)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
